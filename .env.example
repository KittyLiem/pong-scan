# Voorbeeld voor een gedeelde of pilotomgeving. Kopieer naar .env en vervang ALLE waarden:
#   openssl rand -hex 32
# De backend weigert te starten zolang hier nog voorbeeldwaarden staan.
POSTGRES_PASSWORD=vervang-door-een-sterk-wachtwoord
ACCOUNT_TOKEN_SECRET=vervang-door-een-willekeurig-geheim-van-minimaal-32-tekens
APP_ALLOW_INSECURE_LOCAL_DEFAULTS=false
APP_FLYWAY_LOCATIONS=db/migration

# Optioneel: eerste beheerder (wachtwoord min. 12 tekens); haal deze regels na de eerste start weer weg.
# ACCOUNT_BOOTSTRAP_ADMIN_IDENTIFIER=
# ACCOUNT_BOOTSTRAP_ADMIN_PASSWORD=
